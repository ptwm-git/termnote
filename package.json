{
  "name": "agent-note-terminal",
  "version": "0.2.1",
  "private": true,
  "description": "Tabbed terminal sessions saved continuously as Obsidian notes",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:bridge": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "check": "npm test && npm run test:bridge && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
